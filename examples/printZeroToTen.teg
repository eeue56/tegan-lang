
print <-------------- % print the local stack
    # 1 % add 1 to the stack
    sum % sum everything on the stack
    top
    @ top => :counter
    # 10 % push 10 to the stack to check if it's summed
    @ eq % consume the 10, check if the sum is 10
    @ not % if not 10, loop
    ? loop
^--------------------

print => :counter
